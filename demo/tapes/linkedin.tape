# LinkedIn video, 1080x1350 after the caption band is added (see burn-captions.sh).
Output demo/out/raw/linkedin.mp4

Set Shell "bash"
Set FontSize 26
Set Width 1080
Set Height 1130
Set Padding 20
Set Framerate 15
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Source demo/tapes/linkedin-scenes.tape
